# ====================================================================
# Production Environment Variables (Koyeb / Cloud Deployment)
# ====================================================================

# 1. Database Configuration (Neon Serverless PostgreSQL)
# Example: postgresql+asyncpg://user:password@ep-xyz.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>/<database>?sslmode=require

# 2. Redis Configuration (Upstash Serverless Redis)
# Example: rediss://default:password@xyz.upstash.io:6379
REDIS_URL=rediss://default:<password>@<upstash-host>:6379

# 3. Application Security & API Key
# Custom secret API key required to access /review endpoints
API_KEY=your-production-secure-api-key

# 4. LLM API Configuration (Groq / Gemini)
LLM_API_KEY=gsk_your_groq_or_gemini_api_key
LLM_MODEL=openai/gpt-oss-120b

# 5. GitHub App Webhook Secret
# Secret configured in your GitHub App settings for HMAC validation
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# 6. GitHub App Integration (Optional: only needed if posting comments/checks to GitHub PRs)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=654321
# Either provide the private key text directly (easier for cloud envs) or a file path:
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/key.pem

# 7. Rate Limiting Settings
RATE_LIMIT_REVIEW_MAX=10
RATE_LIMIT_REVIEW_WINDOW_SECONDS=60
